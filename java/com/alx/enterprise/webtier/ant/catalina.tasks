reload=com.alx.enterprise.webtier.ant.ReloadTask
stop=com.alx.enterprise.webtier.ant.StopTask
undeploy=com.alx.enterprise.webtier.ant.UndeployTask
resources=com.alx.enterprise.webtier.ant.ResourcesTask
sessions=com.alx.enterprise.webtier.ant.SessionsTask
validator=com.alx.enterprise.webtier.ant.ValidatorTask
findleaks=com.alx.enterprise.webtier.ant.FindLeaksTask
vminfo=com.alx.enterprise.webtier.ant.VminfoTask
threaddump=com.alx.enterprise.webtier.ant.ThreaddumpTask
