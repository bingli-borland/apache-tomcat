-include: build-defaults.bnd

Bundle-Name: tomcat-coyote
Bundle-SymbolicName: com.alx.enterprise.web-coyote
Export-Package: \
    com.alx.enterprise.web.crane,\
    com.alx.enterprise.web.crane.ajp,\
    com.alx.enterprise.web.crane.http11,\
    com.alx.enterprise.web.crane.http11.filters,\
    com.alx.enterprise.web.crane.http11.upgrade,\
    com.alx.enterprise.web.crane.http2,\
    com.alx.enterprise.web.util.bcel.classfile,\
    com.alx.enterprise.web.util.http,\
    com.alx.enterprise.web.util.http.fileupload,\
    com.alx.enterprise.web.util.http.fileupload.disk,\
    com.alx.enterprise.web.util.http.fileupload.impl,\
    com.alx.enterprise.web.util.http.fileupload.servlet,\
    com.alx.enterprise.web.util.http.fileupload.util,\
    com.alx.enterprise.web.util.http.parser,\
    com.alx.enterprise.web.util.log,\
    com.alx.enterprise.web.util.modeler,\
    com.alx.enterprise.web.util.modeler.modules,\
    com.alx.enterprise.web.util.net,\
    com.alx.enterprise.web.util.net.jsse,\
    com.alx.enterprise.web.util.net.openssl,\
    com.alx.enterprise.web.util.net.openssl.ciphers
X-Compile-Source-JDK: ${compile.release}
X-Compile-Target-JDK: ${compile.release}

-includepackage: \
    com.alx.enterprise.web.util.bcel,\
    com.alx.enterprise.web.util.http.fileupload.util.mime

-jpms-module-info: \
    ${module.name};\
        access=32;\
        version=${Bundle-Version}
-jpms-module-info-options: \
    ${module.name};\
        substitute=${Bundle-Name}
