-include: build-defaults.bnd

Bundle-Name: tomcat-embed-jasper
Bundle-SymbolicName: com.alx.enterprise.web-embed-jasper
Export-Package: \
    javax.servlet.jsp.*;version=2.3,\
    com.alx.enterprise.web.jasper,\
    com.alx.enterprise.web.jasper.compiler,\
    com.alx.enterprise.web.jasper.compiler.tagplugin,\
    com.alx.enterprise.web.jasper.el,\
    com.alx.enterprise.web.jasper.optimizations,\
    com.alx.enterprise.web.jasper.runtime,\
    com.alx.enterprise.web.jasper.security,\
    com.alx.enterprise.web.jasper.servlet,\
    com.alx.enterprise.web.jasper.tagplugins.jstl,\
    com.alx.enterprise.web.jasper.tagplugins.jstl.core,\
    com.alx.enterprise.web.jasper.util,\
    com.alx.enterprise.web.util.descriptor.tld
X-Compile-Source-JDK: ${compile.release}
X-Compile-Target-JDK: ${compile.release}

-includepackage: \
    com.alx.enterprise.web.jasper.resources

-includeresource.meta-inf: /META-INF/=${tomcat.output}/manifests/jasper.jar/

Provide-Capability: \
    osgi.contract;\
        osgi.contract=JavaJSP;\
        version:List<Version>="2.3,2.2,2.1,2";\
        uses:='${packages;NAMED;javax.servlet.jsp.*}'

-namesection: javax/servlet/jsp*/;\
    Specification-Title='Java API for JavaServer Pages';\
    Specification-Version=2.3;\
    Specification-Vendor='Sun Microsystems, Inc.';\
    Implementation-Title=javax.servlet.jsp;\
    Implementation-Version=2.3.${jsp.revision};\
    Implementation-Vendor='Apache Software Foundation'

-jpms-module-info: \
    ${module.name};\
        access=32;\
        version=${Bundle-Version}
-jpms-module-info-options: \
    ${module.name};\
        substitute=${Bundle-Name}
