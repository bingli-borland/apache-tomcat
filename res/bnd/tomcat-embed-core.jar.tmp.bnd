-include: build-defaults.bnd

Bundle-Name: tomcat-embed-core
Bundle-SymbolicName: com.alx.enterprise.web-embed-core
Export-Package: \
    !javax.servlet.jsp.*,\
    javax.annotation.*;version=1.3,\
    javax.security.auth.message.*;version=1.1,\
    javax.servlet.*;version=4.0,\
    com.alx.enterprise.webtier,\
    com.alx.enterprise.webtier.authenticator,\
    com.alx.enterprise.webtier.authenticator.jaspic,\
    com.alx.enterprise.webtier.connector,\
    com.alx.enterprise.webtier.core,\
    com.alx.enterprise.webtier.deploy,\
    com.alx.enterprise.webtier.filters,\
    com.alx.enterprise.webtier.loader,\
    com.alx.enterprise.webtier.manager,\
    com.alx.enterprise.webtier.manager.host,\
    com.alx.enterprise.webtier.manager.util,\
    com.alx.enterprise.webtier.mapper,\
    com.alx.enterprise.webtier.mbeans,\
    com.alx.enterprise.webtier.realm,\
    com.alx.enterprise.webtier.security,\
    com.alx.enterprise.webtier.servlets,\
    com.alx.enterprise.webtier.session,\
    com.alx.enterprise.webtier.startup,\
    com.alx.enterprise.webtier.users,\
    com.alx.enterprise.webtier.util,\
    com.alx.enterprise.webtier.valves,\
    com.alx.enterprise.webtier.valves.rewrite,\
    com.alx.enterprise.webtier.webresources,\
    com.alx.enterprise.webtier.webresources.war,\
    com.alx.enterprise.web.crane,\
    com.alx.enterprise.web.crane.ajp,\
    com.alx.enterprise.web.crane.http11,\
    com.alx.enterprise.web.crane.http11.filters,\
    com.alx.enterprise.web.crane.http11.upgrade,\
    com.alx.enterprise.web.crane.http2,\
    com.alx.enterprise.logging,\
    com.alx.enterprise.logging.internal,\
    com.alx.enterprise.naming,\
    com.alx.enterprise.naming.factory,\
    com.alx.enterprise.naming.java,\
    com.alx.enterprise.web,\
    com.alx.enterprise.web.jni,\
    com.alx.enterprise.web.util,\
    com.alx.enterprise.web.util.bcel.classfile,\
    com.alx.enterprise.web.util.buf,\
    com.alx.enterprise.web.util.codec.binary,\
    com.alx.enterprise.web.util.collections,\
    com.alx.enterprise.web.util.compat,\
    com.alx.enterprise.web.util.concurrent,\
    com.alx.enterprise.web.util.descriptor,\
    com.alx.enterprise.web.util.descriptor.tagplugin,\
    com.alx.enterprise.web.util.descriptor.web,\
    com.alx.enterprise.web.util.digester,\
    com.alx.enterprise.web.util.file,\
    com.alx.enterprise.web.util.http,\
    com.alx.enterprise.web.util.http.fileupload,\
    com.alx.enterprise.web.util.http.fileupload.disk,\
    com.alx.enterprise.web.util.http.fileupload.impl,\
    com.alx.enterprise.web.util.http.fileupload.servlet,\
    com.alx.enterprise.web.util.http.fileupload.util,\
    com.alx.enterprise.web.util.http.parser,\
    com.alx.enterprise.web.util.log,\
    com.alx.enterprise.web.util.modeler,\
    com.alx.enterprise.web.util.modeler.modules,\
    com.alx.enterprise.web.util.net,\
    com.alx.enterprise.web.util.net.openssl,\
    com.alx.enterprise.web.util.net.openssl.ciphers,\
    com.alx.enterprise.web.util.res,\
    com.alx.enterprise.web.util.scan,\
    com.alx.enterprise.web.util.security,\
    com.alx.enterprise.web.util.threads
X-Compile-Source-JDK: ${compile.release}
X-Compile-Target-JDK: ${compile.release}

-includepackage: \
    com.alx.enterprise.naming.factory.webservices,\
    com.alx.enterprise.web.util.bcel,\
    com.alx.enterprise.web.util.http.fileupload.util.mime,\
    com.alx.enterprise.web.util.json,\
    com.alx.enterprise.web.util.net.jsse

-includeresource.notice2: META-INF/NOTICE=${tomcat.output}/manifests/servlet-api.jar.notice
-includeresource.license2: META-INF/LICENSE=${tomcat.output}/manifests/servlet-api.jar.license

Provide-Capability: \
    osgi.contract;\
        osgi.contract=JavaJASPIC;\
        version:List<Version>="1.1,1";\
        uses:='${packages;NAMED;javax.security.auth.message.*}',\
    osgi.contract;\
        osgi.contract=JavaServlet;\
        version:List<Version>="4.0,3.1,3,2.5";\
        uses:='${packages;NAMED;javax.servlet.*;NAMED;!javax.servlet.jsp.*}'

-namesection: \
    javax/security/auth/message*/;\
        Specification-Title='Java Authentication SPI for Containers';\
        Specification-Version=1.1;\
        Specification-Vendor='Sun Microsystems, Inc.';\
        Implementation-Title=javax.security.auth.message;\
        Implementation-Version=1.1.${jaspic.revision};\
        Implementation-Vendor='Apache Software Foundation',\
    javax/annotation*/;\
        Implementation-Title=javax.annotation;\
        Implementation-Vendor='Apache Software Foundation';\
        Implementation-Version=1.3.${annotation.revision};\
        Specification-Title='Common Annotations';\
        Specification-Vendor='Oracle Corporation';\
        Specification-Version=1.3,\
    javax/servlet*/;\
        Specification-Title='Java API for Servlets';\
        Specification-Version=4.0;\
        Specification-Vendor='Sun Microsystems, Inc.';\
        Implementation-Title=javax.servlet;\
        Implementation-Version=4.0.${servlet.revision};\
        Implementation-Vendor='Apache Software Foundation'

-jpms-module-info: \
    ${module.name};\
        access=32;\
        version=${Bundle-Version};\
        modules='\
            java.persistence,\
            javax.ejb.api,\
            javax.mail.api,\
            javax.xml.rpc.api,\
            javax.xml.ws'
-jpms-module-info-options: \
    ${module.name};substitute=tomcat-embed-core,\
    java.persistence;static=true,\
    javax.ejb.api;static=true,\
    javax.mail.api;static=true,\
    javax.xml.rpc.api;static=true,\
    javax.xml.ws;static=true
