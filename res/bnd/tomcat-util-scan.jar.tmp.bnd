-include: build-defaults.bnd

Bundle-Name: tomcat-util-scan
Bundle-SymbolicName: com.alx.enterprise.web-util-scan
Export-Package: \
    com.alx.enterprise.web.util.descriptor,\
    com.alx.enterprise.web.util.descriptor.tagplugin,\
    com.alx.enterprise.web.util.descriptor.tld,\
    com.alx.enterprise.web.util.descriptor.web,\
    com.alx.enterprise.web.util.digester,\
    com.alx.enterprise.web.util.scan
X-Compile-Source-JDK: ${compile.release}
X-Compile-Target-JDK: ${compile.release}

-jpms-module-info: \
    ${module.name};\
        access=32;\
        version=${Bundle-Version}
-jpms-module-info-options: \
    ${module.name};\
        substitute=${Bundle-Name}
