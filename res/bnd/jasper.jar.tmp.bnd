-include: build-defaults.bnd

Bundle-Name: tomcat-jasper
Bundle-SymbolicName: com.alx.enterprise.web-jasper
Export-Package: \
    com.alx.enterprise.web.jasper,\
    com.alx.enterprise.web.jasper.compiler,\
    com.alx.enterprise.web.jasper.compiler.tagplugin,\
    com.alx.enterprise.web.jasper.el,\
    com.alx.enterprise.web.jasper.optimizations,\
    com.alx.enterprise.web.jasper.runtime,\
    com.alx.enterprise.web.jasper.servlet,\
    com.alx.enterprise.web.jasper.tagplugins.jstl,\
    com.alx.enterprise.web.jasper.tagplugins.jstl.core,\
    com.alx.enterprise.web.jasper.util
X-Compile-Source-JDK: ${compile.release}
X-Compile-Target-JDK: ${compile.release}

-includepackage: \
    com.alx.enterprise.web.jasper.resources

-includeresource.meta-inf: /META-INF/=${tomcat.output}/manifests/jasper.jar/

-jpms-module-info: \
    ${module.name};\
        access=32;\
        version=${Bundle-Version};\
        modules='ecj'
-jpms-module-info-options: \
    ${module.name};\
        substitute=jasper
