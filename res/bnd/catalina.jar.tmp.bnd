-include: build-defaults.bnd

Bundle-Name: tomcat-catalina
Bundle-SymbolicName: com.alx.enterprise.web-catalina
Export-Package: \
    com.alx.enterprise.webtier.authenticator,\
    com.alx.enterprise.webtier.authenticator.jaspic,\
    com.alx.enterprise.webtier.connector,\
    com.alx.enterprise.webtier.core,\
    com.alx.enterprise.webtier.deploy,\
    com.alx.enterprise.webtier.filters,\
    com.alx.enterprise.webtier.loader,\
    com.alx.enterprise.webtier.manager,\
    com.alx.enterprise.webtier.manager.host,\
    com.alx.enterprise.webtier.mapper,\
    com.alx.enterprise.webtier.mbeans,\
    com.alx.enterprise.webtier.realm,\
    com.alx.enterprise.webtier.security,\
    com.alx.enterprise.webtier.servlets,\
    com.alx.enterprise.webtier.session,\
    com.alx.enterprise.webtier.startup,\
    com.alx.enterprise.webtier.users,\
    com.alx.enterprise.webtier.util,\
    com.alx.enterprise.webtier.valves,\
    com.alx.enterprise.webtier.valves.rewrite,\
    com.alx.enterprise.webtier.webresources,\
    com.alx.enterprise.naming,\
    com.alx.enterprise.naming.factory,\
    com.alx.enterprise.naming.java,\
    com.alx.enterprise.webtier.webresources.war,\
    com.alx.enterprise.webtier.manager.util,\
    com.alx.enterprise.webtier
X-Compile-Source-JDK: ${compile.release}
X-Compile-Target-JDK: ${compile.release}

-includepackage: \
    com.alx.enterprise.naming.factory.webservices

-jpms-module-info: \
    ${module.name};\
        access=32;\
        version=${Bundle-Version};\
        modules='\
            jakarta.ejb,\
            jakarta.mail,\
            jakarta.persistence,\
            jakarta.xml.ws,\
            java.xml.ws'
-jpms-module-info-options: \
    ${module.name};substitute=catalina,\
    jakarta.ejb;static=true,\
    jakarta.mail;static=true,\
    jakarta.persistence;static=true,\
    jakarta.xml.ws;static=true,\
    java.xml.ws;static=true
